# Copy to .env (git-ignored) and fill in only the services you have.
# Used by the eval runner (scripts/eval, EvalRunner) to compare cloud providers with the local models.
# The app itself doesn't read this file: paste keys in Settings → Providers (stored in the Keychain).

# Deepgram Nova-3 speech-to-text: https://console.deepgram.com
DEEPGRAM_API_KEY=

# AI cleanup, OpenAI-compatible. Groq: https://console.groq.com/keys  ·  OpenAI: https://platform.openai.com/api-keys
GROQ_API_KEY=
OPENAI_API_KEY=
